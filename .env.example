# =============================================================================
# ROOT .env -- Smart Contracts and Deploy
# =============================================================================
# Read by:
#   - services/smart-contracts/hardhat.config.js
#   - services/smart-contracts/scripts/deploy.js
#
# DO NOT put Next.js / web frontend variables here.
# Frontend variables live in: services/web/.env.local
# =============================================================================

# --- Tenderly Virtual TestNet (only required for `npm run deploy:tenderly`) ---
TENDERLY_RPC_URL= # from tenderly.com
TENDERLY_CHAIN_ID= # from tenderly.com
TENDERLY_DEPLOYER_PRIVATE_KEY=0x<test_only_key>

# --- ChainProof contract registry (deploy script) ---
CONTRACT_REGISTRY_KEY=chainproof
CONTRACT_REGISTRY_PATH=/config/contracts.json
CONTRACT_VERSION=2.0.0

# =============================================================================
# services/web/.env.local -- ChainProof Next.js Frontend
# =============================================================================
# Read ONLY by the Next.js app in services/web (Next.js auto-loads .env.local
# from its own project root; it does not read the repo-root .env).
#
# DO NOT put Hardhat / deploy variables here.
# Backend variables live in: <repo-root>/.env
# =============================================================================

# --- Chain connection (browser-visible) ---
NEXT_PUBLIC_CHAIN_RPC_URL=          # http://127.0.0.1:8545 or cloudflare tunnel url for local deployment
                                    # tenderly url for tenderly deployment
NEXT_PUBLIC_CHAIN_ID=1337
NEXT_PUBLIC_CONTRACT_REGISTRY_KEY=chainproof

# --- WalletConnect (required for mobile / iOS wallet flow) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID= # from reown.com, copy project id

# --- NFC verification (server-side only -- never NEXT_PUBLIC_*) ---
NFC_DEVICE_DEFAULT_SECRET=chainproof-demo-signing-key
# NFC_DEVICE_KEYS_JSON={"744DBDFFFE68":"replace-me-with-per-device-secret"}
